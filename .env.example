# ─── REQUIRED ─────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

JWT_SECRET=your_jwt_secret_here_64_characters
NODE_ENV=development
PORT=3000
ENCRYPTION_KEY=your_encryption_key_here_64_characters

# Database
MONGO_URI=mongodb://localhost:27017/graphit

# CORS
CLIENT_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_AUTH=10
RATE_LIMIT_MAX_API=180

# Security
SESSION_SECRET=your_session_secret_here_32_characters
COOKIE_SECRET=your_cookie_secret_here_32_characters
BCRYPT_ROUNDS=12

# ─── OPTIONAL ─────────────────────────────────────────────────
# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Monitoring
HEALTH_CHECK_INTERVAL=30000
METRICS_ENABLED=true

# Email (for password reset)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Production specific
HTTPS_REDIRECT=true
SECURE_COOKIES=true
CSP_ENABLED=true

# For production, set NODE_ENV=production
# Cookies will then require HTTPS (secure: true)